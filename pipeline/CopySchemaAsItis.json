										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"value": "@if(\r\n    equals(item().name,'customers.csv'),\r\n    pipeline().parameters.customers,\r\n    if(\r\n        equals(item().name,'drivers.csv'),\r\n        pipeline().parameters.drivers,\r\n        if(\r\n            equals(item().name,'trips.csv'),\r\n            pipeline().parameters.trips,\r\n            ''\r\n        )\r\n    )\r\n)",
									"type": "Expression"
								}
							},
							"inputs": [
								{
									"referenceName": "ds_adls_schema_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"container": "source",
										"folder": "multidestination",
										"file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_adls_schema_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"container": "target",
										"folder": "multidestination",
										"file": {
											"value": "@item().name",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
